<main class="main">
  <article>
    <header class="contents-header">
      <ul class="pankuzu inner">
        <li><a href="../../../../../nw/"><span class="fas fa-home" aria-label="トップページ"></span></a></li>
        <!-- InstanceBeginEditable name="pankuzu" -->
